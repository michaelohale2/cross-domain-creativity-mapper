GEMINI_API_KEY=your-key-here
MODEL=gemini/gemini-2.5-flash
LLM_TIMEOUT_SECONDS=120
# Optional: a separate (ideally stronger) model to score creativity; defaults to MODEL
# JUDGE_MODEL=gemini/your-judge-model
# Which backend to use: gemini (online, default) or local (Ollama). --provider overrides it.
# LLM_PROVIDER=gemini
# Local model served by Ollama, used when the provider is local
# LOCAL_MODEL=gemma4
# OLLAMA_HOST=http://localhost:11434
